# Admin Analytics — copy to .env for local development (never commit .env)
# On Vercel: Project Settings → Environment Variables → add the same keys for Production + Preview

# --- Admin login (/admin/analytics) ---
# Required on Vercel. Local dev bypasses login when both are unset.
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_SESSION_SECRET=your-random-session-secret-min-32-chars

# Shared secret for /api/analytics/* routes (also used as ADMIN_SESSION_SECRET fallback)
ANALYTICS_API_SECRET=your-random-api-secret-min-32-chars

# --- Google Analytics 4 Data API ---
# Numeric property ID from GA4 Admin → Property Settings
GA4_PROPERTY_ID=123456789

# Recommended on Vercel: paste the full service account JSON as one line
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Alternative split credentials (if not using GOOGLE_SERVICE_ACCOUNT_JSON)
# GOOGLE_CLIENT_EMAIL=...@....iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# GOOGLE_PROJECT_ID=your-gcp-project-id

# --- Local-only alternative ---
# Place service account JSON at: secrets/google-service-account.json
# (gitignored; not used on Vercel runtime)

# --- Google Search Console API ---
# Uses the same GOOGLE_SERVICE_ACCOUNT_JSON as GA4 (no separate secret needed).
# Search Console property URL (must match property in GSC exactly)
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.drotgenclinic.com/

# Search Console setup checklist:
# 1. Enable "Google Search Console API" in the same GCP project
# 2. In Search Console → Settings → Users → add service account email as Full or Restricted user
# 3. Property URL must match GOOGLE_SEARCH_CONSOLE_SITE_URL exactly (with trailing slash)

# --- Google Business Profile API (optional — Local SEO admin) ---
# Preferred durable setup (scope: https://www.googleapis.com/auth/business.manage):
# GOOGLE_BUSINESS_ACCOUNT_ID=accounts/12345678901234567890
# GOOGLE_BUSINESS_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# GOOGLE_BUSINESS_CLIENT_SECRET=GOCSPX-...
# GOOGLE_BUSINESS_REFRESH_TOKEN=1//0...
# Optional short-lived fallback (auto-refreshed when refresh credentials are set):
# GOOGLE_BUSINESS_ACCESS_TOKEN=ya29.a0AfH6SMB...

# --- GA4 setup checklist ---
# 1. Create a Google Cloud service account with Analytics Data API enabled
# 2. In GA4 → Admin → Property Access Management → add service account email as Viewer
# 3. GTM container GTM-T89LPZWD should publish to the same GA4 property
